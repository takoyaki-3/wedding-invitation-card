# このファイルには架空の値のみを記載します。
# .env.local にコピーして実際の内容に変更してください。
WEDDING_GROOM="Taro"
WEDDING_BRIDE="Hanako"
WEDDING_GROOM_JAPANESE="山田 太郎"
WEDDING_BRIDE_JAPANESE="鈴木 花子"
# 日時はタイムゾーン込みで指定。未定なら空欄。
WEDDING_DATE=""
WEDDING_END_DATE=""
# 回答締切は必須。以下はサンプルです。
WEDDING_DEADLINE="2099-10-01T23:59:59+09:00"
WEDDING_RECEPTION_TIME=""
WEDDING_CEREMONY_TIME=""
WEDDING_PARTY_TIME=""
WEDDING_VENUE="SAMPLE WEDDING VENUE"
WEDDING_VENUE_JAPANESE="サンプル会場"
WEDDING_ADDRESS="正式な住所を入力してください"
WEDDING_ACCESS="最寄り駅からのアクセスを入力してください"
WEDDING_MAP_QUERY="サンプル会場"
WEDDING_CONTACT_EMAIL="wedding@example.com"

# 以下はサーバー・CDK専用。フロントエンドには埋め込みません。
# 送信元が空欄なら WEDDING_CONTACT_EMAIL を使用。
SES_SENDER_EMAIL=""
# 既存の認証済みIDを使う場合に設定（ARNを優先）。
# 両方空欄ならCDKで送信元メールアドレスIDを作成。
SES_IDENTITY_DOMAIN=""
SES_IDENTITY_ARN=""
SES_CONFIGURATION_SET_NAME=""
# 新郎・新婦それぞれの通知先（回答者のメール入力有無によらず通知）。
RSVP_GROOM_EMAIL=""
RSVP_BRIDE_EMAIL=""
# 追加の通知先が必要な場合のみ設定（従来設定との互換用）。
RSVP_HOST_EMAIL=""
